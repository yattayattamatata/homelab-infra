# {{ ansible_managed }}
---
services:
  jellyfin:
    image: jellyfin/jellyfin:{{ jellyfin_version }}
    container_name: jellyfin
    user: "{{ app_uid }}:{{ app_gid }}"
    group_add:
      - "{{ render_gid }}"
    devices:
      - /dev/dri:/dev/dri
    volumes:
      - /srv/appdata/jellyfin/config:/config
      - /srv/appdata/jellyfin/cache:/cache
      - /mnt/data/media:/media:ro
    ports:
      - "8096:8096"
    restart: unless-stopped
