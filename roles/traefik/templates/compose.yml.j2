# {{ ansible_managed }}
---

services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    env_file: .env
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /srv/appdata/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - /srv/appdata/traefik/certs:/certs
    networks:
      - proxy
    restart: unless-stopped

networks:
  proxy:
    external: true
