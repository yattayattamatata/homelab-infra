# {{ ansible_managed }}
---

services:
  kiwix:
    image: ghcr.io/kiwix/kiwix-serve:{{ kiwix_version }}
    container_name: kiwix
    user: "{{ app_uid }}:{{ app_gid }}"
    volumes:
      - /srv/storage/kiwix:/data:ro
    command: "*.zim"
    ports:
      - "8080:8080"
    networks:
      - proxy
    labels:
      - traefik.enable=true
      - traefik.http.routers.kiwix.rule=Host(`kiwix.{{ travel_domain }}`)
      - traefik.http.routers.kiwix.entrypoints=websecure
      - traefik.http.services.kiwix.loadbalancer.server.port=8080
    restart: unless-stopped

networks:
  proxy:
    external: true
